{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "odaya-token-calculator-edge",
  "compatibility_date": "2026-08-09",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "token.odaya.ai",
      "custom_domain": true
    }
  ]
}
